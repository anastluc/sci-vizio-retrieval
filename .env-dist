# FIREBASE_PROJECT_ID=demo-sci-vizio
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# STORAGE_BACKEND=local
# FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173
# STRIPE_SECRET_KEY=sk_test_...
