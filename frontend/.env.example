# Copy to .env.local for development (Vite loads it automatically).

# Base URL of the API (Heroku app URL in production).
VITE_API_BASE_URL=http://localhost:8000

# Firebase web app config: Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Use the local Firebase Auth emulator (firebase emulators:start --only auth).
VITE_USE_AUTH_EMULATOR=false
